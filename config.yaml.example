# DJ Treta — config.yaml example.
# Copy to config.yaml and customize. config.yaml is gitignored.
#
# All secrets and machine-specific values should live in .env, not here.

mixxx:
  # Local Mixxx with http-rest-api branch (see mixxx-treta repo).
  url: "http://localhost:7778"
  timeout: 5
  auto_start: true
  # Leave empty to auto-detect; or hard-code on a server build.
  binary: ""
  resource_path: ""
  settings_path: ""

llm:
  # LiteLLM proxy on the local machine. See docs/LITELLM_VERTEX_SETUP.md.
  model: "openai/gemini-3.5-flash"
  api_base: "http://localhost:4000"
  api_key: ""  # set via .env: DJTRETA_LLM_API_KEY (preferred)
  temperature: 0.7
  timeout: 30

library:
  # Where your audio files live. Tracks in DB are stored relative to this.
  music_dir: "~/Music/DJTreta"

transitions:
  lookahead_seconds: 120
  default_duration: 60
  fps: 20

daemon:
  heartbeat_interval_seconds: 30.0
  pulse_interval_seconds: 5.0
  poll_hz: 2
  max_errors: 10

capabilities:
  # Set true only on a trusted machine — agent can run shell commands.
  allow_shell: false

planner:
  replan_every_n_tracks: 2
  download_new_tracks: 3
  generate_new_tracks: 1
  min_play_time_seconds: 90

sets:
  auto_mode: true
  default_duration_minutes: 120
  recording_dir: "~/Music/DJTreta/recordings"
  local_recording: false

relay:
  # Enable to push live state to a remote frontend over WebSocket.
  # Leave disabled for local dev; the frontend is optional.
  enabled: false
  server_url: ""  # e.g. "wss://your-relay-host/ws/relay"
  token: ""  # set via .env: DJTRETA_RELAY_TOKEN
  push_hz: 3

broadcast:
  auto_start: false

producer:
  # AI track generation via Vertex AI Lyria 3. Optional.
  enabled: false
  model: "lyria-3-pro-preview"
  vertex_project: ""  # set via .env: DJTRETA_VERTEX_PROJECT
  vertex_location: "us-central1"
  default_duration_seconds: 180
  genre_dir: "ai-generated"

sources:
  youtube: true
  treta_originals: false

knowledge:
  # Enable to use the NaturNestAI/electronic-music-knowledge dataset
  # (~5GB v4 with embeddings). Falls back gracefully when disabled.
  enabled: false
  data_dir: "~/Music/DJTreta/knowledge"
  embedding_model: "text-embedding-005"
  embedding_dim: 384

set:
  default_mood: "melodic techno"
  energy_max_jump: 2
  peak_max_consecutive: 3

evolution:
  enabled: false
  reflect_every_n_tracks: 5
  auto_evolve: false
  max_evolve_per_day: 2
  max_budget_per_evolve_usd: 0.50
  require_tests: true
