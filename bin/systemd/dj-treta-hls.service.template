[Unit]
Description=DJ Treta HLS encoder (AAC 192k, parallel to MP3 Icecast)
After=pulseaudio.service
Requires=pulseaudio.service

[Service]
Type=simple
User=__SVC_USER__
Group=pulse-access
Environment=PULSE_SERVER=unix:/var/run/pulse/native
ExecStartPre=/bin/bash -c "rm -f __HLS_DIR__/*.m3u8 __HLS_DIR__/*.m4s __HLS_DIR__/*.aac __HLS_DIR__/init*.mp4"
ExecStart=/bin/bash -c "parec --server=/var/run/pulse/native --device=djtreta_out.monitor --format=s16le --rate=48000 --channels=2 | ffmpeg -hide_banner -loglevel warning -f s16le -ar 48000 -ac 2 -i - -c:a aac -b:a 192k -ar 48000 -ac 2 -f hls -hls_time 4 -hls_list_size 6 -hls_flags delete_segments+append_list+independent_segments -hls_segment_type fmp4 -hls_segment_filename __HLS_DIR__/seg%%05d.m4s __HLS_DIR__/live.m3u8"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
