[Unit]
Description=DJ Treta LiteLLM proxy (Vertex AI gateway on :4000)
After=network-online.target
Wants=network-online.target
Before=dj-treta-agent.service

[Service]
Type=simple
User=__SVC_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/.venv/bin/litellm --config __INSTALL_DIR__/litellm_config.yaml --port 4000 --host 127.0.0.1
Restart=always
RestartSec=5
StandardOutput=append:__LOGS_DIR__/dj-treta-litellm.log
StandardError=append:__LOGS_DIR__/dj-treta-litellm.log

[Install]
WantedBy=multi-user.target
