[Unit]
Description=DJ Treta Python agent (hot-swappable; safe to restart)
After=dj-treta-mixxx.service dj-treta-litellm.service network-online.target
Wants=dj-treta-mixxx.service dj-treta-litellm.service

[Service]
Type=simple
User=__SVC_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/.venv/bin/python -m agent
Restart=always
RestartSec=5
StandardOutput=append:__LOGS_DIR__/dj-treta-agent.log
StandardError=append:__LOGS_DIR__/dj-treta-agent.log

[Install]
WantedBy=multi-user.target
