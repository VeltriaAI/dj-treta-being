[Unit]
Description=DJ Treta MCP SSE server
After=dj-treta-agent.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SVC_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/.venv/bin/python -m mcp_server.server
Restart=always
RestartSec=3
StandardOutput=append:__LOGS_DIR__/dj-treta-mcp.log
StandardError=append:__LOGS_DIR__/dj-treta-mcp.log

[Install]
WantedBy=multi-user.target
