# DJ Treta — deploy.sh configuration.
# Copy to .env.deploy (gitignored) and fill in your values.
# Required by bin/deploy-vm.sh and bin/install-vm.sh.

# ── SSH target ──────────────────────────────────────────────────────────
VM_USER=your-username
VM_HOST=your.vm.example.com
VM_PATH=/path/to/dj-treta-on-vm
SSH_KEY=$HOME/.ssh/your-private-key

# ── systemd template variables (used by bin/install-vm.sh) ──────────────
# These fill placeholders in bin/systemd/*.service.template before
# enabling each unit.

# User the services run as (must own VM_PATH and the music library).
SVC_USER=$VM_USER

# Where DJ Treta's Python code + venv lives on the VM.
INSTALL_DIR=$VM_PATH

# Mixxx (built from mixxx-treta repo with the http-rest-api branch).
MIXXX_BIN=/opt/mixxx-treta/build/mixxx
MIXXX_RESOURCE=/opt/mixxx-treta/res
MIXXX_SETTINGS=$HOME/.mixxx-treta

# Audio pipeline paths.
LOGS_DIR=/var/log/dj-treta
HLS_DIR=/var/lib/dj-treta/hls
EZSTREAM_CONFIG=/etc/dj-treta/ezstream.xml

# Xvfb display number (Mixxx needs an X display, even headless).
DISPLAY_NUM=99
