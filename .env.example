# DJ Treta — environment variables.
# Copy to .env and fill in your values. .env is gitignored.

# ── Required: LLM access ────────────────────────────────────────────────
# DJ Treta talks to Mixxx and Vertex AI through a local LiteLLM proxy
# (see docs/LITELLM_VERTEX_SETUP.md to start it). Set the proxy's auth key
# here; the agent passes it through.
DJTRETA_LLM_API_KEY=sk-litellm-replace-me
# Override the proxy URL if you run it elsewhere (default: http://localhost:4000)
# DJTRETA_LLM_API_BASE=http://localhost:4000

# ── Required: Mixxx HTTP API ───────────────────────────────────────────
# Your Mixxx instance with the http-rest-api branch built. Default works
# for a local dev setup.
# DJTRETA_MIXXX_URL=http://localhost:7778

# ── Vertex AI (only if Producer / Lyria 3 is enabled) ──────────────────
# Required for AI track generation. Set your own GCP project + location.
# Authenticate via `gcloud auth application-default login` OR by setting
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key file.
# DJTRETA_VERTEX_PROJECT=your-gcp-project-id
# DJTRETA_VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── HuggingFace (only if downloading the knowledge dataset) ────────────
# Get a token at https://huggingface.co/settings/tokens
# read scope is enough to download; write needed to publish.
# HF_TOKEN=hf_replace_me

# ── Relay (only if you run a public state-broadcasting server) ─────────
# Leave unset for local dev. Production uses these to push live state to
# a remote frontend (e.g. dj.treta.life).
# DJTRETA_RELAY_TOKEN=your-relay-shared-secret

# ── MCP server tokens (only if you expose dj-treta over MCP) ───────────
# DJTRETA_MCP_TOKEN=generate-with-`openssl rand -base64 32`
# DJTRETA_COMMAND_TOKEN=generate-with-`openssl rand -base64 32`
# DJTRETA_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# DJTRETA_MCP_ALLOWED_ORIGINS=http://localhost:3000
