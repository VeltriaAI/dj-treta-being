# v5 audio pipeline — environment variables.
# Copy to .env (gitignored) and fill in your values.

# ── GCP — pick region close to your audience for lowest latency ──────
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCP_ZONE=asia-south1-a
GCP_REGION=asia-south1

# ── HuggingFace ────────────────────────────────────────────────────────
# Read scope minimum to download v4; write needed to publish v5.
HF_TOKEN=hf_replace_me
HF_DATASET_REPO=NaturNestAI/electronic-music-knowledge

# ── Pipeline ───────────────────────────────────────────────────────────
# Output dataset version (writes to <DATASET_VERSION>/* on HF + GCS).
DATASET_VERSION=v5

# Run identifier — change to start a fresh queue. Same RUN_ID resumes.
RUN_ID=v5-2026-04-27

# Worker fleet (heavy pipeline: download + Essentia + madmom + structure +
# VAD + CLAP + musicnn + htdemucs stems + per-stem analysis + basic-pitch
# MIDI + Whisper on vocals stem + multi-res mel spectrograms + GCS upload).
# n2-standard-4 chosen for better CPU vs e2 for stems compute.
WORKER_COUNT=3                # 3 for test, 128 for full 2.94M production
WORKER_MACHINE_TYPE=n2-standard-4
WORKERS_PER_VM=3              # parallel processes inside each VM
USE_SPOT_WORKERS=true

# Coordinator machine type.
COORDINATOR_MACHINE_TYPE=e2-standard-2

# ── Priority queue filter ──────────────────────────────────────────────
# Only analyze tracks matching these criteria from v4. Adjust to scale.
PRIORITY_MIN_YEAR=2020
PRIORITY_REQUIRE_VIDEO_ID=true
PRIORITY_LIMIT=600      # 600 for test, 0 for full 2.94M

# ── Audio + stems retention ────────────────────────────────────────────
# Always keep audio + stems in GCS for live Treta playback + future training.
# Storage cost (Mumbai): ~$23/TB/mo Standard, $13/TB/mo Nearline.
# Per track: ~5 MB audio + ~20 MB stems + ~10 MB mel + assets = ~35 MB.
# 200K tracks ≈ 7 TB. 2.94M tracks ≈ 103 TB.
KEEP_AUDIO_HOT=true
HOT_LIBRARY_TOP_N=0

