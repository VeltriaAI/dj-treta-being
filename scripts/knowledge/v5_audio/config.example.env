# v5 audio pipeline — environment variables.
# Copy to .env (gitignored) and fill in your values.

# ── GCP ────────────────────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCP_ZONE=us-central1-a
GCP_REGION=us-central1

# ── HuggingFace ────────────────────────────────────────────────────────
# Read scope minimum to download v4; write needed to publish v5.
HF_TOKEN=hf_replace_me
HF_DATASET_REPO=NaturNestAI/electronic-music-knowledge

# ── Pipeline ───────────────────────────────────────────────────────────
# Output dataset version (writes to v5/* on HF + GCS).
DATASET_VERSION=v5

# Run identifier — change to start a fresh queue. Same RUN_ID resumes.
RUN_ID=v5-2026-04-27

# Number of worker VMs. 32 = ~18h for 200K tracks.
WORKER_COUNT=32

# Worker fleet machine type.
WORKER_MACHINE_TYPE=e2-standard-4

# Use spot/preemptible workers (much cheaper, can be killed mid-run).
USE_SPOT_WORKERS=true

# Coordinator machine type.
COORDINATOR_MACHINE_TYPE=e2-standard-2

# ── Priority queue filter ──────────────────────────────────────────────
# Only analyze tracks matching these criteria from v4. Adjust to scale.
PRIORITY_MIN_YEAR=2020
PRIORITY_REQUIRE_VIDEO_ID=true
PRIORITY_LIMIT=200000   # 0 = no limit (all matching tracks)

# ── Hot library (audio retention) ──────────────────────────────────────
# If true, upload the analyzed audio to GCS for instant Treta load.
# Storage cost: ~$0.10/mo per 1000 tracks. Default off — only metadata kept.
KEEP_AUDIO_HOT=false
HOT_LIBRARY_TOP_N=5000   # only top N most-relevant tracks if KEEP_AUDIO_HOT=true
